# Rentman Booking Visualizer - API Routing
# =========================================

# Aktivera URL-omskrivning
RewriteEngine On

# Sätt bas-sökväg (anpassa om API ligger i undermapp)
RewriteBase /api/

# Skicka alla requests till index.php (utom befintliga filer)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php [QSA,L]

# Skydda config-filer
<FilesMatch "^config\.php$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Skydda cache-mappen
<IfModule mod_rewrite.c>
    RewriteRule ^cache/ - [F,L]
</IfModule>

# Förhindra directory listing
Options -Indexes

# Sätt rätt content-type för JSON
<IfModule mod_mime.c>
    AddType application/json .json
</IfModule>

# CORS headers (backup om PHP inte sätter dem)
<IfModule mod_headers.c>
    Header always set Access-Control-Allow-Origin "*"
    Header always set Access-Control-Allow-Methods "GET, POST, OPTIONS"
    Header always set Access-Control-Allow-Headers "Content-Type, Authorization"
</IfModule>

# Komprimera JSON-svar
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE application/json
</IfModule>
