# Rentman Booking Visualizer - Apache Configuration for one.com

# ============================================
# PASSWORD PROTECTION (Basic Auth)
# Uncomment and update path to enable
# ============================================
# AuthType Basic
# AuthName "Rentman Booking Visualizer"
# AuthUserFile /customers/DITT_KUNDNUMMER/astronauten.se/.htpasswd
# Require valid-user

# ============================================
# URL REWRITING
# ============================================
RewriteEngine On
RewriteBase /

# Handle API requests - forward to api/index.php
RewriteRule ^api/(.*)$ api/index.php [L,QSA]

# Handle SPA routing - serve index.html for non-existing files
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.html [L]
