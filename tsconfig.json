{
  "compilerOptions": {
    "target": "es5",
    "module": "amd",
    "lib": ["es2015", "dom"],
    "noImplicitAny": false,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "removeComments": true,
    "sourceMap": false,
    "noEmitHelpers": false,
    "moduleResolution": "node",
    "rootDir": ".",
    "typeRoots": ["./node_modules/@types"],
    "isolatedModules": false,
    "skipLibCheck": true,
    "declaration": true,
    "allowSyntheticDefaultImports": true
  }
}
