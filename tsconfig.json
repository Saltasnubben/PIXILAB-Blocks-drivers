{
	"compilerOptions": {
		"target": "ES2015",
		"module": "commonjs",
		"lib": ["ES2015"],
		"outDir": "./dist",
		"rootDir": "./",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"declaration": true,
		"declarationMap": true,
		"sourceMap": true,
		"moduleResolution": "node",
		"baseUrl": "./",
		"paths": {
			"system/*": ["system/*"],
			"system_lib/*": ["system_lib/*"]
		}
	},
	"include": [
		"driver/**/*.ts"
	],
	"exclude": [
		"node_modules",
		"dist"
	]
}
